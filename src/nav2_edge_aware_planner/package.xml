<?xml version="1.0"?>
<package format="3">
  <name>nav2_edge_aware_planner</name>
  <version>0.0.0</version>
  <description>Custom global planner that extends Nav2 to handle goals outside the known map.</description>
  <maintainer email="rakshithrajr@gmail.com">raj</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>nav2_core</depend>
  <depend>nav2_costmap_2d</depend>
  <depend>pluginlib</depend>
  <depend>tf2_ros</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_util</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <nav2_core plugin="${prefix}/edge_aware_planner_plugin.xml" />
  </export>
</package>
